{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@vibe-notes/ui": ["../../packages/ui/src"],
      "@vibe-notes/ui/*": ["../../packages/ui/src/*"],
      "@vibe-notes/notes-core": ["../../packages/notes-core/src"]
    },
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
